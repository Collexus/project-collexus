# Copy these names into .env.local and add values from your own providers.
# Public Supabase values are browser-visible; never place a secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostgreSQL: required for admin role checks and dashboard data. Server only.
# Set DIRECT_URL for Prisma migrations when the provider supplies a direct URL.
DATABASE_URL=
DIRECT_URL=

# Upstash Redis REST credentials. Server only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry DSNs are safe to expose; build upload credentials are server/CI only.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional legacy Supabase public key name accepted by the existing app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
