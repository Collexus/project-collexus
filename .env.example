# Public Supabase values used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Legacy alternative accepted by the client:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Configure WhatsApp delivery in Supabase Auth > Providers > Phone.
# Do not put Twilio auth tokens or SUPABASE_SERVICE_ROLE_KEY in this frontend project.
